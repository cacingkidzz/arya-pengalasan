# ============================================================================
# Folder unggahan (nota, lampiran).
#
# Tujuan: berkas yang diunggah pengguna TIDAK boleh dieksekusi sebagai
# skrip. Hanya gambar/dokumen yang boleh disajikan.
# ============================================================================

# Matikan mesin PHP untuk folder ini (bila PHP dipasang sebagai modul Apache).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Tolak akses ke berkas yang bisa dieksekusi.
<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|pl|py|cgi|sh|bat|exe|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Jangan tampilkan daftar isi folder.
Options -Indexes
