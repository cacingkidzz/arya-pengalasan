# ============================================================================
# Folder database — tolak akses lewat web.
#
# Dump SQL berisi data pribadi warga. Bila folder ini ikut terunggah ke
# hosting, berkas .sql tidak boleh bisa diunduh dari browser.
# ============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
